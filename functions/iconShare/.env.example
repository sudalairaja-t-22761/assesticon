# Copy to .env (local dev) or .env.production (deploy). Both are git-ignored.

# ── API access ────────────────────────────────────────────────────────────────
# Callers send it as `x-api-token: <token>`, `Authorization: Bearer <token>` or `?token=`.
# Deployed on Catalyst the API refuses every request until this is set; locally an empty value allows all.
SHARE_API_TOKEN=
# How long one read of a branch is reused (seconds). ?refresh=1 re-reads at once.
SHARE_CACHE_SECONDS=300
# Comma separated browser origins allowed to call the API (CORS). Empty = any origin.
ALLOWED_ORIGINS=

# ── CRM_UI_LIBRARY (ZohoRepository) — same values as functions/spriteForgeJoin ─
REPO_BASE_URL=https://repository.zohocorpcloud.in
REPO_PROJECT_PATH=zohocorp/ICON_LIBRARY/Icons/crm_core_icons
REPO_NAME=crm_core_icons
REPO_GIT_URL=https://zrepository.zohocorpcloud.in/zohocorp/ICON_LIBRARY/Icons/crm_core_icons.git
# Mock branch (source=mock)
REPO_BRANCH=MOCK_BRANCH
# Master branch (source=master)
MASTER_REPO_BRANCH=master
# Personal access token with read access to the repository
REPO_TOKEN=
REPO_TOKEN_USER=oauth2
REPO_PROVIDER=git
REPO_FILES=resources/images/crmutil_icons.svg,resources/images/svg_cssicons.svg
