# Copy to .env (local dev) or .env.production (catalyst serve / deploy). Both are git-ignored.

# ── API access ────────────────────────────────────────────────────────────────
# Callers send it as `x-api-token: <token>`, `Authorization: Bearer <token>` or `?token=`.
# Deployed on Catalyst the API refuses every request until this is set; locally an empty value allows all.
SPRITE_API_TOKEN=
# true → the API works WITHOUT a token, also on Catalyst (anyone with the URL can append icons to the repo). Default false.
SPRITE_API_PUBLIC=false

# Comma separated browser origins allowed to call the API (CORS). Empty = any origin.
ALLOWED_ORIGINS=

# ── Icon library repo: Iconassest (ZohoRepository) ────────────────────────────
REPO_BASE_URL=https://repository.zohocorpcloud.in
ICON_REPO_PROJECT_PATH=zohocorp/user/sudalairaja.t/Iconassest
ICON_REPO_NAME=Iconassest
ICON_REPO_BRANCH=default
ICON_REPO_GIT_URL=https://zrepository.zohocorpcloud.in/zohocorp/user/sudalairaja.t/Iconassest.git
# The sprite the icons are appended to (repo-root relative).
ICON_REPO_FILES=Sprite/crmutil_icons.svg
# Personal access token with read + write access to the repo (ICON_REPO_TOKEN falls back to REPO_TOKEN).
ICON_REPO_TOKEN=
ICON_REPO_TOKEN_USER=oauth2
# git (isomorphic-git, default) | git-cli | git-auto
ICON_REPO_PROVIDER=git
# Commit author used when the request carries no x-user-name / x-user-email headers.
ICON_REPO_COMMIT_AUTHOR_NAME=SpriteForge Icon Tool
ICON_REPO_COMMIT_AUTHOR_EMAIL=spriteforge@zohocorp.com
ICON_REPO_HTTP_TIMEOUT_MS=20000
ICON_REPO_REQUEST_TIMEOUT_MS=25000

# ── Layout of appended icons (sprite units / px) ──────────────────────────────
# Gap between icons in a row, gap between rows, padding from the sprite edge.
SPRITE_SPACING=7
SPRITE_ROW_GAP=5
SPRITE_PADDING=5

# ── Limits ────────────────────────────────────────────────────────────────────
MAX_ICONS_PER_REQUEST=200
MAX_SVG_BYTES=2097152

# ── Local server port ─────────────────────────────────────────────────────────
PORT=3003
