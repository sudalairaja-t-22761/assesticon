# Copy to .env (local dev) or .env.production (catalyst serve / deploy).
# Both real files are git-ignored — never commit secrets.

# ── Zoho OAuth ────────────────────────────────────────────────────────────────
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Must match what is registered in the Zoho API Console for this client.
ZOHO_REDIRECT_URI=http://localhost:3000/
ZOHO_ACCOUNTS_BASE=https://accounts.zoho.in
ZOHO_SCOPE=openid,email,profile,phone,Stratus.fileop.ALL,Stratus.bucketop.ALL,ZohoCatalyst.buckets.objects.CREATE,ZohoCatalyst.buckets.objects.READ,ZohoCatalyst.buckets.objects.UPDATE,ZohoCatalyst.buckets.objects.DELETE,ZohoCatalyst.buckets.READ
ZOHO_ACCESS_TYPE=offline

# ── Catalyst project ───────────────────────────────────────────────────────────
ZC_PROJECT_ID=
ZC_PROJECT_KEY=
ZC_PROJECT_SECRET_KEY=
ZC_ADMIN_CRED_TYPE=ticket
ZC_ADMIN_CRED_TOKEN=
ZC_ENVIRONMENT=development
CATALYST_ACTIVE_DC=in

# ── Catalyst File Store ────────────────────────────────────────────────────────
FOLDER_ID=

# ── Allowed origins (CORS + redirect-origin allowlist) ────────────────────────
ALLOWED_ORIGINS=

# ── Auth behaviour ─────────────────────────────────────────────────────────────
AUTH_ENFORCE=false
SESSION_TTL_MS=86400000

# ── Catalyst Stratus ──────────────────────────────────────────────────────────
STRATUS_BUCKET_NAME=
STRATUS_BUCKET_URL=
STRATUS_ALLOW_LOCAL_FALLBACK=true

# ── Repository: CRM_UI_LIBRARY (ZohoRepository) ───────────────────────────────
# Web UI of the repository (used to build "open in repository" links).
REPO_BASE_URL=https://repository.zohocorpcloud.in
# Project path as shown in the URL after the host.
REPO_PROJECT_PATH=zohocorp/CRM/CRM_UI/CRM_UI_LIBRARY
REPO_NAME=CRM_UI_LIBRARY
# Branch that the icon tool commits to.
REPO_BRANCH=CRM_UI_LIBRARY_ICON_TOOL
# Git-over-HTTPS endpoint (ZohoRepository redirects *.git to this host).
REPO_GIT_URL=https://zrepository.zohocorpcloud.in/zohocorp/CRM/CRM_UI/CRM_UI_LIBRARY.git
# Personal access token + the username to pair it with for HTTP basic auth.
REPO_TOKEN=
REPO_TOKEN_USER=oauth2
# git (default, uses the git binary) | gitlab | gitea | github (REST API dialects)
REPO_PROVIDER=git
# Files mirrored into the Master UI Library folder (comma separated repo paths).
REPO_FILES=resources/images/crmutil_icons.svg,resources/images/svg_cssicons.svg,resources/icon-styles/svg-icons.less,resources/icon-styles/svg-path.less
# Which stylesheet belongs to which sprite ("sprite.svg:styles.less", comma separated).
REPO_SPRITE_PAIRS=crmutil_icons.svg:svg-icons.less,svg_cssicons.svg:svg-path.less
# Commit author used when the signed-in user has no name/email.
REPO_COMMIT_AUTHOR_NAME=SpriteForge Icon Tool
REPO_COMMIT_AUTHOR_EMAIL=spriteforge@zohocorp.com

# ── Master UI Library folder (Stratus / local) ────────────────────────────────
MASTER_LIBRARY_FOLDER=Master_ui_library
# true → folder is only served to signed-in users (visible to every logged-in user)
MASTER_LIBRARY_REQUIRE_LOGIN=true

# ── Local server port ─────────────────────────────────────────────────────────
PORT=3001
